---
import Layout from "../layouts/Layout.astro";
import NetworkHero from "../components/NetworkHero.astro";
import RoleIcon from "../components/RoleIcon.astro";

const lab = [
  {
    name: "Jarvis",
    tagline: "Multi-model agent, 20+ tools, Azure",
    description:
      "The public stand-in for production agent work I cannot publish from a service-provider data center. Per-user identity, tool orchestration across calendar, email, and ops systems, and model routing across DeepSeek R1 (NVIDIA NIM), Gemini Live, Grok Vision, Claude, and GPT. FastAPI on Azure, Expo iOS, Firestore sync.",
    live: "https://jarvis.landrycmd.com",
    github: null,
  },
  {
    name: "MCP Integration Simulator",
    tagline: "Interactive diagram · generalized",
    description:
      "The MCP hub on its own page: clients and agents on one side, the hub in the middle, servers and tools on the other, with packets moving along the links. 28 servers, about 573 tools, 44 agents, 31 skills, and 23 agents I authored. The firewall review is a separate lab. Every name and system is generalized.",
    live: "/lab/mcp-simulator/",
    github: null,
  },
  {
    name: "Firewall Request Review",
    tagline: "Interactive diagram · generalized",
    description:
      "The review flow on its own page. A read-only agent walks a firewall change request through eight checks and stops at a human. Backlog from 200 to about 40; review time from 30–60 minutes to 3–5 minutes.",
    live: "/lab/frr-review/",
    github: null,
  },
  {
    name: "Zero-Downtime Migration Simulator",
    tagline: "Interactive diagram · generalized",
    description:
      "The migration method I built and ran across 14 markets: instead of cutting a gateway over, put both vendors' routers in one redundancy group so the new one sits as the deliberate loser, then move traffic by changing a priority value. The pair is replaced one device at a time, always taking out the member carrying no traffic. Toggle hardcut against straddle and watch the packets-lost counter while client traffic keeps flowing. Real failure modes included.",
    live: "/lab/migration-simulator/",
    github: null,
  },
  {
    name: "Ring Collapse Simulator",
    tagline: "Interactive diagram · generalized",
    description:
      "A metro re-architecture: two parallel topologies collapsed into one. The video ring was not legacy cruft — it existed because a single-service topology needs almost no QoS. Collapsing it means accepting that burden everywhere. Toggle the sequencing to see why I added hub capacity four months before touching the ring.",
    live: "/lab/ring-collapse/",
    github: null,
  },
  {
    name: "AirTap MPLS",
    tagline: "Interactive diagram · 2010–2011",
    description:
      "Offshore Gulf of Mexico rigs over point-to-point microwave into Cisco 7200s, then Time Warner and AT&T fiber MPLS. Each customer has its own VRF, kept apart with BGP and EIGRP and extended to that customer's data center. Two internet egresses, multihomed BGP. AirTap Communications. A small subset of the wireless field, plus the 3.65 GHz sector plan.",
    live: "/lab/airtap-mpls/",
    github: null,
  },
];

const shipped = [
  {
    name: "ACT Prep",
    tagline: "Shipped app · act.landrycmd.com",
    description:
      "Adaptive ACT prep for Louisiana TOPS thresholds, FSRS spaced repetition, AI tutor. Proof I will take a system to a real user, not stop at a demo.",
    live: "https://act.landrycmd.com",
  },
  {
    name: "PeptideTracker",
    tagline: "Shipped app · peptidetrackers.com",
    description:
      "Mobile and web logging with auth, inventory, and shareable protocols. Same reason: live users, not a slide.",
    live: "https://peptidetrackers.com",
  },
];

const openSource = [
  {
    name: "mcp-audit",
    description:
      "Static-analysis security auditor for MCP server packages. Capability map, risk findings, and a score without executing the audited code. The artifact I can show when a customer asks what a third-party agent is allowed to do.",
    repo: "https://github.com/bradylandry/mcp-audit",
  },
  {
    name: "second-brain-template",
    description:
      "Markdown vault that AI tools can read and write. Folder contracts, frontmatter, /braindump. The write-up is the best explanation of how I actually work.",
    repo: "https://github.com/bradylandry/second-brain-template",
    article: "/writing/second-brain-for-my-ai",
  },
];

const experience = [
  { role: "Technical Solutions Lead", org: "Independent practice · landrycmd", period: "2026 – Present", icon: "agent" },
  { role: "Senior Data Center Network Engineer", org: "Charter/Spectrum (formerly Cox Communications) · National Data Center", period: "2021 – Present", icon: "arista" },
  { role: "Senior Backbone Network Engineer", org: "Charter/Spectrum (formerly Cox Communications)", period: "2018 – 2021", icon: "mx2020" },
  { role: "Senior Network Engineer", org: "Charter/Spectrum (formerly Cox Communications) · Metro", period: "2012 – 2018", icon: "asr9k" },
  { role: "Network Operations Engineer", org: "Charter/Spectrum (formerly Cox Communications)", period: "2011 – 2012", icon: "switch" },
  { role: "RF & IP Network Engineer", org: "AirTap · Skyrider · Detel Wireless", period: "2005 – 2011", icon: "rf" },
];
---

<Layout
  title="landrycmd | Brady Landry"
  description="Brady Landry's public AI lab: production agents, MCP servers, and retrieval systems. Twenty years of service-provider networking; the internal tools stay off this site, so this is the work you can inspect."
>
  <section class="hero hero-net">
    <NetworkHero />
    <div class="hero-content">
      <h1>landrycmd</h1>
      <p class="tagline">
        <span class="prompt">&gt;</span>Public AI lab for a network architect
        who cannot publish the systems he built at work. MCP servers, agents,
        and retrieval you can click.<span class="cursor"></span>
      </p>
    </div>
  </section>

  <section id="about">
    <p class="kicker">// about</p>
    <h2>About</h2>
    <p>
      Brady Landry designs and operates Tier 1 service provider and data center
      networks: 20 years in, 15 of them at Charter/Spectrum (formerly Cox
      Communications) across the national IP backbone, regional data centers,
      and metro. Day job is Arista
      spine and leaf, Infrastructure-as-Code standards, and the
      <a href="/work/ai-network-operations">AI Network Operations Platform (MCP)</a>.
      The case study is the public account of that platform. Internal runbooks
      stay off this site.
    </p>
    <p>
      landrycmd is the home lab that stands in for it. Same problems, public
      artifacts: remote MCP servers with per-user Microsoft Entra identity on
      Azure, an agent chassis other deployments inherit, retrieval over document
      stores, and a static-analysis auditor for third-party agent packages. If
      you are here from a résumé, this is the evidence behind the AI bullets.
    </p>
    <p class="muted">
      Open to technical sales, architecture, and solutions roles where that mix
      is the job.
    </p>
    <p>
      <a href="https://github.com/bradylandry" rel="noopener">GitHub</a>
      &nbsp;·&nbsp;
      <a href="https://www.linkedin.com/in/bradylandry/" rel="noopener">LinkedIn</a>
      &nbsp;·&nbsp;
      <a href="mailto:bjlandry@gmail.com">Email</a>
      &nbsp;·&nbsp;
      <a href="/resume">Résumé</a>
    </p>
  </section>

  <section id="work">
    <p class="kicker">// work</p>
    <h2>Work</h2>
    <p>
      The AI Network Operations Platform (MCP) is its own case study: 28 MCP
      servers, about 573 tools, 44 agents, and 31 skills. The firewall request
      review is a separate lab.
    </p>
    <p>
      <a href="/work/ai-network-operations">Read the case study →</a>
      &nbsp;·&nbsp;
      <a href="/lab/mcp-simulator/">MCP hub →</a>
      &nbsp;·&nbsp;
      <a href="/lab/frr-review/">Firewall request review →</a>
    </p>
  </section>

  <section id="lab">
    <p class="kicker">// lab</p>
    <h2>What you can inspect</h2>
    <div class="node-list">
      {
        lab.map((p) => (
          <div class="project">
            <div class="project-head">
              <h3>{p.name}</h3>
              <span class="muted">{p.tagline}</span>
              <span class="links">
                {p.live && (
                  <a href={p.live} rel="noopener">
                    Live →
                  </a>
                )}
              </span>
            </div>
            <p class="project-desc">{p.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="open-source">
    <p class="kicker">// open source</p>
    <h2>Open source</h2>
    <div class="node-list">
      {
        openSource.map((r) => (
          <div class="project">
            <div class="project-head">
              <h3>{r.name}</h3>
              <span class="links">
                <a href={r.repo} rel="noopener">
                  Repo →
                </a>
                {r.article && <a href={r.article}>Article →</a>}
              </span>
            </div>
            <p class="project-desc">{r.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="experience">
    <p class="kicker">// experience</p>
    <h2>Experience</h2>
    <div class="node-list icons">
      {
        experience.map((e) => (
          <div class="project">
            <RoleIcon type={e.icon} />
            <div class="project-head">
              <h3>{e.role}</h3>
              <span class="muted">{e.org}</span>
              <span class="links">{e.period}</span>
            </div>
          </div>
        ))
      }
    </div>
    <p class="muted">
      Full history: <a href="/resume">résumé →</a>
    </p>
  </section>

  <section id="also">
    <p class="kicker">// also shipping</p>
    <h2>Also live</h2>
    <p class="muted">
      Not the reason this lab exists. Evidence that things leave the bench.
    </p>
    <div class="node-list">
      {
        shipped.map((p) => (
          <div class="project">
            <div class="project-head">
              <h3>{p.name}</h3>
              <span class="muted">{p.tagline}</span>
              <span class="links">
                <a href={p.live} rel="noopener">
                  Live →
                </a>
              </span>
            </div>
            <p class="project-desc">{p.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="writing">
    <p class="kicker">// writing</p>
    <h2>Writing</h2>
    <p class="muted">
      How the vault, the agents, and the cheap-stack workflow actually run.
      <a href="/writing/">Read all →</a>
    </p>
  </section>
</Layout>
