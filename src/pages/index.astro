---
import Layout from "../layouts/Layout.astro";
import LabThumb from "../components/LabThumb.astro";
import { getCollection } from "astro:content";
import type { LabSlug } from "../lib/labs";

const lab = [
  {
    name: "Jarvis",
    tagline: "Multi-model agent, 20+ tools",
    description:
      "The public stand-in for production agent work I cannot publish from a service-provider data center. Per-user identity, tool orchestration across calendar, email, and ops systems, and model routing across DeepSeek R1 (NVIDIA NIM), Gemini Live, Grok Vision, Claude, and GPT. FastAPI on Azure, Expo iOS, Firestore sync.",
    live: "https://jarvis.landrycmd.com",
    github: null,
  },
  {
    name: "MCP Integration Simulator",
    tagline: "Interactive",
    fig: "FIG. 01 — Topology",
    meta: "Lab 01",
    chips: ["MCP", "Agents", "Routing"],
    description:
      "Clients and agents on one side, the hub in the middle, servers and tools on the other, with packets moving along the links.",
    live: "/lab/mcp-simulator/",
    github: null,
    slug: "mcp-simulator",
  },
  {
    name: "Firewall Request Review",
    tagline: "Interactive",
    fig: "FIG. 02 — Review",
    meta: "Lab 02",
    chips: ["Read-only", "Eight checks", "Human gate"],
    description:
      "A read-only agent walks a firewall change request through eight checks and stops at a human. Backlog from 200 to about 40; review time from 30–60 minutes to 3–5 minutes.",
    live: "/lab/frr-review/",
    github: null,
    slug: "frr-review",
  },
  {
    name: "Zero-Downtime Migration Simulator",
    tagline: "Interactive",
    fig: "FIG. 03 — Straddle",
    meta: "Lab 03",
    chips: ["VRRP", "Straddle", "Rollback"],
    description:
      "The migration method I built and ran across NEEDS NUMBER markets: instead of cutting a gateway over, put both vendors' routers in one redundancy group so the new one sits as the deliberate loser, then move traffic by changing a priority value. The pair is replaced one device at a time, always taking out the member carrying no traffic. Toggle hardcut against straddle and watch the packets-lost counter while client traffic keeps flowing. Real failure modes included.",
    live: "/lab/migration-simulator/",
    github: null,
    slug: "migration-simulator",
  },
  {
    name: "Ring Collapse Simulator",
    tagline: "Metro redesign",
    fig: "FIG. 04 — Ring collapse",
    meta: "Lab 04",
    chips: ["PIM", "IGMP", "QoS"],
    description:
      "A metro re-architecture: two parallel topologies collapsed into one. The video ring was not legacy cruft — it existed because a single-service topology needs almost no QoS. Collapsing it means accepting that burden everywhere. Toggle the sequencing to see why I added hub capacity NEEDS NUMBER months before touching the ring.",
    live: "/lab/ring-collapse/",
    github: null,
    slug: "ring-collapse",
  },
  {
    name: "AirTap MPLS",
    tagline: "2010–2011",
    fig: "FIG. 05 — Gulf",
    meta: "Lab 05",
    chips: ["MPLS", "BGP", "VRF"],
    description:
      "A top-down Gulf of Mexico: offshore rigs in the water with overlapping coverage, straight microwave shots to three shore landings, then straight north to one inland data center. Two BGP egress peers sit in a cloud above that data center. Each customer keeps its own VRF, with BGP and EIGRP. AirTap Communications. A small subset of the wireless field.",
    live: "/lab/airtap-mpls/",
    github: null,
    slug: "airtap-mpls",
  },
] satisfies Array<{
  name: string;
  tagline: string;
  description: string;
  live: string;
  github: null;
  slug?: LabSlug;
  fig?: string;
  meta?: string;
  chips?: string[];
}>;

const labCards = lab.filter(
  (p): p is (typeof lab)[number] & { slug: LabSlug } => p.slug !== undefined,
);

const shipped = [
  {
    name: "ACT Prep",
    tagline: "Shipped app",
    description:
      "Adaptive ACT prep for Louisiana TOPS thresholds, FSRS spaced repetition, AI tutor. Proof I will take a system to a real user, not stop at a demo.",
    live: "https://act.landrycmd.com",
    repo: null,
  },
  {
    name: "PeptideTracker",
    tagline: "Shipped app",
    description:
      "Mobile and web logging with auth, inventory, and shareable protocols. Same reason: live users, not a slide.",
    live: "https://peptidetrackers.com",
    repo: null,
  },
  {
    name: "Jarvis Quant",
    tagline: "Personal research",
    description:
      "A personal stock-research tool. Paper lab for agent problems: cost-aware model routing, eval loops, and a weekly reviewer that scores approaches against each other. Not a product.",
    live: null,
    repo: "https://github.com/bradylandry/jarvis-trading-mcp",
  },
  {
    name: "Liftbook",
    tagline: "Offline-first PWA",
    description:
      "Workout logging that works offline. Next.js, Supabase, a service worker, and a sync outbox.",
    live: "https://lift.landrycmd.com",
    repo: null,
  },
];

const openSource = [
  {
    name: "mcp-audit",
    description:
      "Static-analysis security auditor for MCP server packages. Capability map, risk findings, and a score without executing the audited code. The artifact I can show when a customer asks what a third-party agent is allowed to do.",
    repo: "https://github.com/bradylandry/mcp-audit",
  },
  {
    name: "second-brain-template",
    description:
      "Markdown vault that AI tools can read and write. Folder contracts, frontmatter, /braindump. The write-up is the best explanation of how I actually work.",
    repo: "https://github.com/bradylandry/second-brain-template",
    article: "/writing/second-brain-for-my-ai",
  },
];

const experience = [
  { role: "Technical Solutions Lead", org: "Independent practice · landrycmd", period: "2026 – Present", icon: "agent" },
  { role: "Senior Data Center Network Engineer", org: "Charter/Spectrum (formerly Cox Communications) · National Data Center", period: "2021 – Present", icon: "arista" },
  { role: "Senior Backbone Network Engineer", org: "Charter/Spectrum (formerly Cox Communications)", period: "2018 – 2021", icon: "mx2020" },
  { role: "Senior Network Engineer", org: "Charter/Spectrum (formerly Cox Communications) · Metro", period: "2012 – 2018", icon: "asr9k" },
  { role: "Network Operations Engineer", org: "Charter/Spectrum (formerly Cox Communications)", period: "2011 – 2012", icon: "switch" },
  { role: "RF & IP Network Engineer", org: "AirTap · Skyrider · Detel Wireless", period: "2005 – 2011", icon: "rf" },
];

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title))
  .slice(0, 3);

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}

const jarvis = lab.find((p) => p.slug === undefined);
---

<Layout
  title="landrycmd | Brady Landry"
  description="Brady Landry's public AI lab: production agents, MCP servers, and retrieval systems. Twenty years of service-provider networking; the internal tools stay off this site, so this is the work you can inspect."
>
  <link slot="head" rel="stylesheet" href="/lab/wire.css" />
  <style slot="head" is:inline>
    .lab-card .flow { opacity: 0; animation: none; }
    .lab-card:hover .flow,
    .lab-card:focus-within .flow,
    .lab-card.inview .flow.on {
      opacity: 0.95;
      animation: dash 1.05s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .lab-card .flow,
      .lab-card .flow.on,
      .lab-card:hover .flow,
      .lab-card:focus-within .flow,
      .lab-card.inview .flow.on {
        animation: none;
        opacity: 0.5;
      }
    }
  </style>

  <section class="band hero-band">
    <div class="wrap">
      <div class="profile">
        <div class="grid">
        <figure class="portrait">
          <span class="reg tl" aria-hidden="true"></span>
          <img
            src="/brady.jpg"
            width="480"
            height="480"
            alt="Portrait of Brady Landry"
          />
          <span class="reg br" aria-hidden="true"></span>
          <figcaption>
            <span>BRADY LANDRY</span>
            <span>LOUISIANA, USA</span>
          </figcaption>
        </figure>
        <div class="profile-id">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Open to architecture &amp; solutions roles</p>
          <h1 id="profile-name">Brady Landry</h1>
          <p class="hero-role">Network Architect · AI Automation</p>
          <p class="bio">
            15 years building and running service-provider networks
            at Cox, now Charter/Spectrum. <b>Making national programs land in
            markets and handing them to operations.</b> Building the tooling that makes it
            repeatable, from a 2014 config generator through Ansible to an AI/MCP
            operations platform.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href="/resume">Résumé <span class="ext">↗</span></a>
            <a class="btn" href="https://www.linkedin.com/in/bradylandry/" rel="noopener">LinkedIn <span class="ext">↗</span></a>
            <a class="btn" href="https://github.com/bradylandry" rel="noopener">GitHub <span class="ext">↗</span></a>
            <a class="btn" href="mailto:bjlandry@gmail.com">Email</a>
          </div>
        </div>
        </div>
      </div>
      <div class="hero hero-net stats">
        <div class="stat"><b>20 yrs</b><small>Service-provider networks</small></div>
        <div class="stat"><b>28</b><small>MCP servers in production</small></div>
        <div class="stat"><b>23</b><small>Agents authored</small></div>
        <div class="stat"><b>5</b><small>Interactive labs</small></div>
      </div>
    </div>
  </section>

  <section class="band" id="work">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>01</b> // work</p>
          <h2>Work</h2>
        </div>
        <div class="sbody">
          <p class="lead">The production platform I can’t publish, told as a case study you can read in five minutes.</p>
          <a class="feature" href="/work/ai-network-operations">
            <div>
              <p class="meta"><b>Case study</b> · 2024 – present</p>
              <h3>AI Network Operations Platform</h3>
              <p>An MCP-based operations layer for a national IP backbone: agents that read, reason, and stop at a human.</p>
              <div class="nums">
                <div><b>28</b>MCP servers</div>
                <div><b>~573</b>Tools</div>
                <div><b>44</b>Agents</div>
                <div><b>31</b>Skills</div>
              </div>
            </div>
            <span class="arrow">Read →</span>
          </a>
          <p class="sublinks">
            <a href="/lab/mcp-simulator/">MCP hub ↗</a>
            <a href="/lab/frr-review/">Firewall request review ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="lab">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>02</b> // lab</p>
          <h2>What you can inspect</h2>
        </div>
        <div class="sbody">
          <p class="lead">Interactive diagrams of real designs. Names and systems are generalized; the engineering isn’t.</p>
        </div>
        <div class="lab-grid">
          {
            labCards.map((p) => (
              <div class="project lab-card">
                <div class="scope">
                  <span class="figtag">{p.fig}</span>
                  <LabThumb lab={p.slug} />
                </div>
                <div class="lab-card-body">
                  <p class="meta"><b>{p.meta}</b> · {p.tagline}</p>
                  <h3>
                    <button
                      type="button"
                      class="lab-open"
                      data-lab={p.slug}
                      data-lab-name={p.name}
                      aria-haspopup="dialog"
                      aria-controls="lab-dialog"
                      aria-expanded="false"
                    >
                      {p.name}
                    </button>
                  </h3>
                  <p class="project-desc">{p.description}</p>
                  <div class="chips">
                    {p.chips?.slice(0, 3).map((chip) => (
                      <span class="chip">{chip}</span>
                    ))}
                  </div>
                  <div class="lab-foot">Open lab <span>→</span></div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <dialog id="lab-dialog" class="lab-dialog" aria-labelledby="lab-dialog-title">
      <div class="lab-dialog-bar">
        <h2 id="lab-dialog-title">Lab</h2>
        <a class="lab-dialog-page" href="/lab/mcp-simulator/">Open page ↗</a>
        <button type="button" class="lab-dialog-close">Close</button>
      </div>
      <iframe class="lab-dialog-frame" title="Lab simulation" allow="fullscreen" allowfullscreen></iframe>
    </dialog>
  </section>
  <script>
    import { mountLabDialog } from "../scripts/lab-dialog";
    mountLabDialog();
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const cards = document.querySelectorAll(".lab-card");
    if (!reduce && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const on = entry.isIntersecting;
            entry.target.classList.toggle("inview", on);
            entry.target.querySelectorAll(".flow").forEach((flow) => {
              flow.classList.toggle("on", on);
            });
          }
        },
        { threshold: 0.35 },
      );
      cards.forEach((card) => {
        card.querySelectorAll(".flow").forEach((flow) => flow.classList.remove("on"));
        io.observe(card);
      });
    }
  </script>

  <section class="band" id="open-source">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>03</b> // open source</p>
          <h2>Open source</h2>
        </div>
        <div class="sbody">
          <div class="node-list">
          <div class="rows">
            {
              openSource.map((r) => (
                <div class="row">
                  <h3>{r.name}</h3>
                  <p>{r.description}</p>
                  <span class="links">
                    <a href={r.repo} rel="noopener" target="_blank">Repo ↗</a>
                    {r.article && <a href={r.article}>Article →</a>}
                  </span>
                </div>
              ))
            }
          </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="experience">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>04</b> // experience</p>
          <h2>Experience</h2>
        </div>
        <div class="sbody">
          <div class="rows">
            {
              experience.map((e) => (
                <div class="row">
                  <p class="years">{e.period}</p>
                  <div>
                    <h3>{e.role}</h3>
                    <p>{e.org}</p>
                  </div>
                  <span class="links"></span>
                </div>
              ))
            }
          </div>
          <p class="text-links">
            <a href="/resume">Résumé →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="also">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>05</b> // also live</p>
          <h2>Shipped</h2>
        </div>
        <div class="sbody">
          <div class="rows">
            {
              shipped.map((p) => (
                <div class="row">
                  <h3>{p.name}</h3>
                  <p>{p.description}</p>
                  <span class="links">
                    {p.live && (
                      <a href={p.live} rel="noopener" target="_blank">Live ↗</a>
                    )}
                    {p.repo && (
                      <a href={p.repo} rel="noopener" target="_blank">Repo ↗</a>
                    )}
                  </span>
                </div>
              ))
            }
            {
              jarvis && (
                <div class="row">
                  <h3>{jarvis.name}</h3>
                  <p>{jarvis.description}</p>
                  <span class="links">
                    <a href={jarvis.live} rel="noopener" target="_blank">Live ↗</a>
                  </span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="writing">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>06</b> // writing</p>
          <h2>Writing</h2>
        </div>
        <div class="sbody">
          <div class="rows">
            {
              posts.map((post) => (
                <div class="row">
                  <p class="years">{formatDate(post.data.date)}</p>
                  <h3>{post.data.title}</h3>
                  <a href={`/writing/${post.slug}/`}>Read →</a>
                </div>
              ))
            }
          </div>
          <p class="text-links">
            <a href="/writing/">All writing →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="about">
    <div class="wrap">
      <div class="grid">
        <div class="shead">
          <p class="kicker"><b>07</b> // about</p>
          <h2>About</h2>
        </div>
        <div class="sbody">
          <div class="about-grid">
            <div>
              <p>
                Brady Landry designs and operates Tier 1 service provider and data center
                networks: 20 years in, 15 of them at Charter/Spectrum (formerly Cox
                Communications) across the national IP backbone, regional data centers,
                and metro. Day job is Arista spine and leaf, Infrastructure-as-Code
                standards, and the AI Network Operations Platform. The case study is the
                public account of that platform. Internal runbooks stay off this site.
              </p>
              <p class="text-links">
                <a href="https://www.linkedin.com/in/bradylandry/" rel="noopener">LinkedIn</a>
                <a href="https://github.com/bradylandry" rel="noopener">GitHub</a>
                <a href="mailto:bjlandry@gmail.com">Email</a>
                <a href="/resume">Résumé</a>
              </p>
            </div>
            <dl class="kv">
              <div>
                <dt>Currently</dt>
                <dd>Charter/Spectrum national data center, and an independent architecture practice.</dd>
              </div>
              <div>
                <dt>Previously</dt>
                <dd>Backbone, metro, and the AirTap wireless build.</dd>
              </div>
              <div>
                <dt>Focus</dt>
                <dd>Architecture and solutions roles where networks and automation are the job.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
