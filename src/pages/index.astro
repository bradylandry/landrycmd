---
import Layout from "../layouts/Layout.astro";
import NetworkHero from "../components/NetworkHero.astro";
import RoleIcon from "../components/RoleIcon.astro";

const lab = [
  {
    name: "Jarvis",
    tagline: "Multi-model agent, 20+ tools, Azure",
    description:
      "The public stand-in for production agent work I cannot publish from a service-provider data center. Per-user identity, tool orchestration across calendar, email, and ops systems, and model routing across DeepSeek R1 (NVIDIA NIM), Gemini Live, Grok Vision, Claude, and GPT. FastAPI on Azure, Expo iOS, Firestore sync.",
    live: "https://jarvis.landrycmd.com",
    github: null,
  },
  {
    name: "Jarvis Quant",
    tagline: "Agent orchestration testbed",
    description:
      "A 21-strategy paper-trading lab used to test the same problems a customer AI deployment hits: dual-portfolio A/B testing, cost-aware model routing, eval loops, and a weekly reviewer that scores strategies against each other. Not a product pitch. A working harness.",
    live: "https://trading.landrycmd.com",
    github: null,
  },
];

const shipped = [
  {
    name: "ACT Prep",
    tagline: "Shipped app · act.landrycmd.com",
    description:
      "Adaptive ACT prep for Louisiana TOPS thresholds, FSRS spaced repetition, AI tutor. Proof I will take a system to a real user, not stop at a demo.",
    live: "https://act.landrycmd.com",
  },
  {
    name: "PeptideTracker",
    tagline: "Shipped app · peptidetrackers.com",
    description:
      "Mobile and web logging with auth, inventory, and shareable protocols. Same reason: live users, not a slide.",
    live: "https://peptidetrackers.com",
  },
];

const openSource = [
  {
    name: "mcp-audit",
    description:
      "Static-analysis security auditor for MCP server packages. Capability map, risk findings, and a score without executing the audited code. The artifact I can show when a customer asks what a third-party agent is allowed to do.",
    repo: "https://github.com/bradylandry/mcp-audit",
  },
  {
    name: "jarvis-trading-mcp",
    description:
      "Remote MCP server for the trading lab: Streamable HTTP, per-user authorization, tool schemas. The public cousin of the MCP servers I run against internal systems at work.",
    repo: "https://github.com/bradylandry/jarvis-trading-mcp",
  },
  {
    name: "second-brain-template",
    description:
      "Markdown vault that AI tools can read and write. Folder contracts, frontmatter, /braindump. The write-up is the best explanation of how I actually work.",
    repo: "https://github.com/bradylandry/second-brain-template",
    article: "/writing/second-brain-for-my-ai",
  },
];

const experience = [
  { role: "Technical Solutions Lead", org: "Independent practice · landrycmd", period: "2026 – Present", icon: "agent" },
  { role: "Senior Data Center Network Engineer", org: "Spectrum (formerly Cox Communications) · National Data Center", period: "2021 – Present", icon: "arista" },
  { role: "Senior Backbone Network Engineer", org: "Cox Communications", period: "2018 – 2021", icon: "mx2020" },
  { role: "Senior Network Engineer", org: "Cox Communications · Metro", period: "2012 – 2018", icon: "asr9k" },
  { role: "Network Operations Engineer", org: "Cox Communications", period: "2011 – 2012", icon: "switch" },
  { role: "RF & IP Network Engineer", org: "AirTap · Skyrider · Detel Wireless", period: "2005 – 2011", icon: "rf" },
];
---

<Layout
  title="landrycmd | Brady Landry"
  description="Brady Landry's public AI lab: production agents, MCP servers, and retrieval systems. Twenty years of service-provider networking; the Cox tools stay internal, so this is the work you can inspect."
>
  <section class="hero hero-net">
    <NetworkHero />
    <div class="hero-content">
      <h1>landrycmd</h1>
      <p class="tagline">
        <span class="prompt">&gt;</span>Public AI lab for a network architect
        who cannot publish the systems he built at work. MCP servers, agents,
        and retrieval you can click.<span class="cursor"></span>
      </p>
    </div>
  </section>

  <section id="about">
    <p class="kicker">// about</p>
    <h2>About</h2>
    <p>
      Brady Landry designs and operates Tier 1 service provider and data center
      networks: 20 years in, 15 of them at Cox Communications across the
      national IP backbone, regional data centers, and metro. Day job is Arista
      spine and leaf, Infrastructure-as-Code standards, and an AI automation
      platform wired into the tools engineers actually use. None of that
      internal platform can live on this site.
    </p>
    <p>
      landrycmd is the home lab that stands in for it. Same problems, public
      artifacts: remote MCP servers with per-user Microsoft Entra identity on
      Azure, an agent chassis other deployments inherit, retrieval over document
      stores, and a static-analysis auditor for third-party agent packages. If
      you are here from a résumé, this is the evidence behind the AI bullets.
    </p>
    <p class="muted">
      Open to technical sales, architecture, and solutions roles where that mix
      is the job.
    </p>
    <p>
      <a href="https://github.com/bradylandry" rel="noopener">GitHub</a>
      &nbsp;·&nbsp;
      <a href="https://www.linkedin.com/in/bradylandry/" rel="noopener">LinkedIn</a>
      &nbsp;·&nbsp;
      <a href="mailto:bjlandry@gmail.com">Email</a>
      &nbsp;·&nbsp;
      <a href="/resume">Résumé</a>
    </p>
  </section>

  <section id="lab">
    <p class="kicker">// lab</p>
    <h2>What you can inspect</h2>
    <div class="node-list">
      {
        lab.map((p) => (
          <div class="project">
            <div class="project-head">
              <h3>{p.name}</h3>
              <span class="muted">{p.tagline}</span>
              <span class="links">
                {p.live && (
                  <a href={p.live} rel="noopener">
                    Live →
                  </a>
                )}
              </span>
            </div>
            <p class="project-desc">{p.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="open-source">
    <p class="kicker">// open source</p>
    <h2>Open source</h2>
    <div class="node-list">
      {
        openSource.map((r) => (
          <div class="project">
            <div class="project-head">
              <h3>{r.name}</h3>
              <span class="links">
                <a href={r.repo} rel="noopener">
                  Repo →
                </a>
                {r.article && <a href={r.article}>Article →</a>}
              </span>
            </div>
            <p class="project-desc">{r.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="experience">
    <p class="kicker">// experience</p>
    <h2>Experience</h2>
    <div class="node-list icons">
      {
        experience.map((e) => (
          <div class="project">
            <RoleIcon type={e.icon} />
            <div class="project-head">
              <h3>{e.role}</h3>
              <span class="muted">{e.org}</span>
              <span class="links">{e.period}</span>
            </div>
          </div>
        ))
      }
    </div>
    <p class="muted">
      Full history: <a href="/resume">résumé →</a>
    </p>
  </section>

  <section id="also">
    <p class="kicker">// also shipping</p>
    <h2>Also live</h2>
    <p class="muted">
      Not the reason this lab exists. Evidence that things leave the bench.
    </p>
    <div class="node-list">
      {
        shipped.map((p) => (
          <div class="project">
            <div class="project-head">
              <h3>{p.name}</h3>
              <span class="muted">{p.tagline}</span>
              <span class="links">
                <a href={p.live} rel="noopener">
                  Live →
                </a>
              </span>
            </div>
            <p class="project-desc">{p.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="writing">
    <p class="kicker">// writing</p>
    <h2>Writing</h2>
    <p class="muted">
      How the vault, the agents, and the cheap-stack workflow actually run.
      <a href="/writing/">Read all →</a>
    </p>
  </section>
</Layout>
