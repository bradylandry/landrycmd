---
import Layout from "../layouts/Layout.astro";
import NetworkHero from "../components/NetworkHero.astro";
import RoleIcon from "../components/RoleIcon.astro";

const products = [
  {
    name: "Jarvis Quant",
    tagline: "Algorithmic trading platform",
    description:
      "A 21-strategy paper-trading system with dual-portfolio A/B testing between algorithmic and LLM-driven decision engines. FastAPI + APScheduler, Kelly-sized positions, Bayesian confidence scoring, and a weekly AI reviewer that scores strategies against each other.",
    live: "https://trading.landrycmd.com",
    github: null,
  },
  {
    name: "Jarvis",
    tagline: "Personal AI assistant: voice, chat, iOS",
    description:
      "Multi-model orchestration across DeepSeek R1 (NVIDIA NIM), Gemini Live, Grok Vision, and others. 20+ tools spanning calendar, email, trading, smart home, and journal. FastAPI backend + Expo iOS app + Firestore sync, deployed on GCP.",
    live: "https://jarvis.landrycmd.com",
    github: null,
  },
  {
    name: "PeptideTracker",
    tagline: "Health-tracking mobile + web app",
    description:
      "Peptide reconstitution math, dose logging with injection-site rotation, inventory tracking, and shareable protocols for community reach. Firebase Auth + Firestore + Expo (iOS + web). Live at peptidetrackers.com.",
    live: "https://peptidetrackers.com",
    github: null,
  },
  {
    name: "ACT Prep",
    tagline: "Test-prep app built for Louisiana's TOPS scholarship",
    description:
      "Adaptive ACT exam prep optimized for the score thresholds that unlock Louisiana's TOPS scholarship ($44K+ over four years). Built on the FSRS spaced-repetition algorithm with an AI tutor for personalized study paths. Firebase Auth + Expo web, live at act.landrycmd.com.",
    live: "https://act.landrycmd.com",
    github: null,
  },
];

const openSource = [
  {
    name: "jarvis-ops",
    description:
      "Runbook-first monitoring framework with optional LLM escalation. Ships with working smart-home and trading deployments. MIT licensed.",
    repo: "https://github.com/bradylandry/jarvis-ops",
  },
  {
    name: "second-brain-template",
    description:
      "AI-friendly personal knowledge vault template. Works with Claude Code, Cursor, Continue.dev, Claude Projects, or any AI. Includes /braindump workflow and 6-lens research system.",
    repo: "https://github.com/bradylandry/second-brain-template",
    article: "/writing/second-brain-for-my-ai",
  },
];

const experience = [
  { role: "Data Center Sustaining Engineer", org: "Cox Communications · National Data Center", period: "2021 – Present", icon: "arista" },
  { role: "Backbone Integration Engineer", org: "Cox Communications", period: "2018 – 2021", icon: "mx2020" },
  { role: "Regional Network Operations Engineer", org: "Cox Communications · Metro", period: "2012 – 2018", icon: "asr9k" },
  { role: "Access Engineering", org: "Cox Communications", period: "2011 – 2012", icon: "switch" },
  { role: "RF & IP Network Engineer", org: "AirTap · Skyrider · Detel Wireless", period: "2005 – 2011", icon: "rf" },
];
---

<Layout title="landrycmd | Brady Landry">
  <section class="hero hero-net">
    <NetworkHero />
    <div class="hero-content">
      <h1>landrycmd</h1>
      <p class="tagline">
        <span class="prompt">&gt;</span>Independent software shop run by Brady
        Landry. AI infrastructure, algorithmic trading, and mobile health
        apps.<span class="cursor"></span>
      </p>
    </div>
  </section>

  <section id="products">
    <p class="kicker">// products</p>
    <h2>Products</h2>
    <div class="node-list">
    {
      products.map((p) => (
        <div class="project">
          <div class="project-head">
            <h3>{p.name}</h3>
            <span class="muted">{p.tagline}</span>
            <span class="links">
              {p.live && (
                <a href={p.live} rel="noopener">
                  Live →
                </a>
              )}
              {p.github && (
                <a href={p.github} rel="noopener">
                  GitHub →
                </a>
              )}
            </span>
          </div>
          <p class="project-desc">{p.description}</p>
        </div>
      ))
    }
    </div>
  </section>

  <section id="open-source">
    <p class="kicker">// open source</p>
    <h2>Open source</h2>
    <div class="node-list">
    {
      openSource.map((r) => (
        <div class="project">
          <div class="project-head">
            <h3>{r.name}</h3>
            <span class="links">
              <a href={r.repo} rel="noopener">
                Repo →
              </a>
              {r.article && (
                <a href={r.article}>
                  Article →
                </a>
              )}
            </span>
          </div>
          <p class="project-desc">{r.description}</p>
        </div>
      ))
    }
    </div>
  </section>

  <section id="about">
    <p class="kicker">// about</p>
    <h2>About</h2>
    <p>
      Brady Landry is a network and systems architect with 20 years designing,
      automating, and operating mission-critical infrastructure, 15 of them at
      Cox Communications' National Data Center, where he leads Arista SP Fabric
      migrations, Infrastructure-as-Code standards, and an AI-driven network
      automation platform (nearly 20 MCP servers and 30+ Claude sub-agents used
      daily for config review, change-impact analysis, and migration planning).
      His earlier career was hands-on RF, microwave, and satellite network
      engineering.
    </p>
    <p>
      landrycmd is the independent AI lab he runs outside that work: production
      tools (Jarvis, the trading platform), open-source frameworks (jarvis-ops,
      second-brain-template), and writing on the architectural patterns that
      hold up in real systems.
    </p>
    <p class="muted">Open to select architecture, AI, and solutions roles.</p>
    <p>
      <a href="https://github.com/bradylandry" rel="noopener">GitHub</a>
      &nbsp;·&nbsp;
      <a href="https://www.linkedin.com/in/bradylandry/" rel="noopener"
        >LinkedIn</a
      >
      &nbsp;·&nbsp;
      <a href="mailto:support@landrycmd.com">Email</a>
    </p>
  </section>

  <section id="experience">
    <p class="kicker">// experience</p>
    <h2>Experience</h2>
    <div class="node-list icons">
    {
      experience.map((e) => (
        <div class="project">
          <RoleIcon type={e.icon} />
          <div class="project-head">
            <h3>{e.role}</h3>
            <span class="muted">{e.org}</span>
            <span class="links">{e.period}</span>
          </div>
        </div>
      ))
    }
    </div>
    <p class="muted">
      Full history and early career: <a href="/resume">résumé →</a>
    </p>
  </section>

  <section id="writing">
    <p class="kicker">// writing</p>
    <h2>Writing</h2>
    <p class="muted">
      Long-form pieces on infrastructure, AI tooling, and shipping side
      products. <a href="/writing/">Read all →</a>
    </p>
  </section>
</Layout>
