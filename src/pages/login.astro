---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Applications" noindex={true}>
  <div class="login-page">
    <div class="login-card">
      <div class="login-title" id="loginTitle">🔒 Applications</div>
      <div class="login-subtitle" id="loginSubtitle">Enter the applications code</div>

      <div class="pin-display" id="pinDisplay">
        <div class="pin-dot"></div>
        <div class="pin-dot"></div>
        <div class="pin-dot"></div>
        <div class="pin-dot"></div>
      </div>

      <div class="pin-keypad" id="keypad">
        <button type="button" class="pin-key" data-key="1">1</button>
        <button type="button" class="pin-key" data-key="2">2</button>
        <button type="button" class="pin-key" data-key="3">3</button>
        <button type="button" class="pin-key" data-key="4">4</button>
        <button type="button" class="pin-key" data-key="5">5</button>
        <button type="button" class="pin-key" data-key="6">6</button>
        <button type="button" class="pin-key" data-key="7">7</button>
        <button type="button" class="pin-key" data-key="8">8</button>
        <button type="button" class="pin-key" data-key="9">9</button>
        <button type="button" class="pin-key empty" tabindex="-1"></button>
        <button type="button" class="pin-key" data-key="0">0</button>
        <button type="button" class="pin-key delete" data-key="del">⌫</button>
      </div>

      <div class="pin-error" id="pinError"></div>
    </div>
  </div>

  <script is:inline>
    const params = new URLSearchParams(location.search);
    const rawNext = params.get("next") || "";
    const next = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "/applications";

    const display = document.getElementById("pinDisplay");
    const keypad = document.getElementById("keypad");
    const error = document.getElementById("pinError");
    const dots = display.querySelectorAll(".pin-dot");

    let pin = "";
    let submitting = false;

    function render() {
      dots.forEach((d, i) => {
        if (i < pin.length) d.classList.add("filled");
        else d.classList.remove("filled");
      });
    }

    function clearError() {
      error.textContent = "";
      error.classList.remove("pin-success");
    }

    async function submit() {
      if (submitting) return;
      submitting = true;
      clearError();
      try {
        const res = await fetch("/api/auth", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ pin }),
        });
        const data = await res.json();
        if (data.ok) {
          error.textContent = "Unlocked ✓";
          error.classList.add("pin-success");
          setTimeout(() => {
            location.href = next;
          }, 350);
        } else {
          error.textContent = data.error || "Wrong code";
          pin = "";
          render();
          display.style.animation = "none";
          display.offsetHeight;
          display.style.animation = "shake 0.3s ease";
          submitting = false;
        }
      } catch (e) {
        error.textContent = "Network error — try again";
        submitting = false;
      }
    }

    keypad.addEventListener("click", (e) => {
      const btn = e.target.closest(".pin-key");
      if (!btn || btn.classList.contains("empty")) return;
      const key = btn.dataset.key;
      if (submitting) return;
      clearError();

      if (key === "del") {
        pin = pin.slice(0, -1);
      } else if (pin.length < 4) {
        pin += key;
      }
      render();
      if (pin.length === 4) setTimeout(submit, 150);
    });

    window.addEventListener("keydown", (e) => {
      if (submitting) return;
      if (/^\d$/.test(e.key) && pin.length < 4) {
        pin += e.key;
        clearError();
        render();
        if (pin.length === 4) setTimeout(submit, 150);
      } else if (e.key === "Backspace") {
        pin = pin.slice(0, -1);
        render();
      }
    });
  </script>
</Layout>

<style is:global>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: radial-gradient(ellipse at center, var(--signal-wash), transparent 70%),
      var(--bg);
  }

  .login-card {
    background: rgba(16, 20, 26, 0.82);
    border: 1px solid color-mix(in srgb, var(--signal) 35%, transparent);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    max-width: 360px;
    width: 100%;
    text-align: center;
    backdrop-filter: blur(12px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 60px var(--signal-wash);
  }

  .login-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    background: linear-gradient(135deg, #fff, var(--signal));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .login-subtitle {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
  }

  .pin-display {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pin-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--signal) 45%, transparent);
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pin-dot.filled {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 16px var(--signal-wash);
    transform: scale(1.1);
  }

  .pin-keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .pin-key {
    font-size: 1.5rem;
    font-weight: 600;
    padding: 1rem 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .pin-key:hover {
    background: var(--signal-wash);
    border-color: var(--signal);
    transform: translateY(-2px);
  }

  .pin-key:active {
    transform: scale(0.95);
    background: color-mix(in srgb, var(--signal) 24%, transparent);
  }

  .pin-key.empty {
    visibility: hidden;
  }

  .pin-key.delete {
    font-size: 1.2rem;
  }

  .pin-error {
    margin-top: 1rem;
    color: #ef4444;
    font-size: 0.85rem;
    min-height: 1.2rem;
    animation: shake 0.3s ease;
  }

  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-6px);
    }
    75% {
      transform: translateX(6px);
    }
  }

  .pin-success {
    color: #10b981 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .pin-dot,
    .pin-key,
    .pin-error {
      transition: none;
      animation: none;
    }
    .pin-key:hover,
    .pin-key:active,
    .pin-dot.filled {
      transform: none;
    }
  }
</style>
