  {
    name: "📸 Bethesda Fountain (Friday bike ride)",
    detail: "The Gossip Girl spot — Karsyn + Blake will want this photo. Already on the route.",
    map: "Bethesda Fountain Central Park",
  },
  {
    name: "🌉 Manhattan Bridge view from DUMBO",
    detail: "Saturday — Washington St in DUMBO with the Manhattan Bridge framed by buildings. The Iconic shot.",
    map: "Washington Street DUMBO Manhattan Bridge view",
  },
  {
    name: "🗽 Battery Park night view",
    detail: "Statue of Liberty is lit up at night — visible from Battery Park. Can pair with any evening you're downtown (Sat dinner area).",
    map: "Battery Park New York",
  },
];

const desserts = [
  { name: "Levain Bakery", detail: "Giant warm cookies, multiple Manhattan locations. Iconic NYC bakery.", map: "Levain Bakery 167 W 74th" },
  { name: "Anita Gelato", detail: "SoHo location fits Friday afternoon perfectly between shopping and the subway home.", map: "Anita La Mamma del Gelato SoHo" },
  { name: "Junior's Cheesecake", detail: "Times Square, walk-in friendly, iconic NYC cheesecake. Could pair with Thursday after Wicked.", map: "Junior's Times Square" },
  { name: "Magnolia Bakery", detail: "Banana pudding fame. Bleecker St (West Village) or Rockefeller location.", map: "Magnolia Bakery Bleecker Street" },
];

const rainBackup = [
  { name: "Grand Central Terminal", detail: "Indoor exploring + food hall. Whispering Gallery, Zodiac ceiling. Already on Thursday — could expand.", map: "Grand Central Terminal" },
  { name: "Chelsea Market", detail: "Indoor food hall + shops. Could be a full afternoon.", map: "Chelsea Market New York" },
  { name: "American Museum of Natural History", detail: "Massive, indoor, great rainy-day pivot. Dinosaurs, planetarium, ocean room.", map: "American Museum of Natural History" },
  { name: "SUMMIT One Vanderbilt", detail: "Glass observation experience near Grand Central. Mirrored rooms = Karsyn/Blake Insta gold. Different from Top of the Rock.", map: "Summit One Vanderbilt" },
  { name: "Eataly Flatiron", detail: "Indoor food hall 2 blocks from hotel. Backup for any meal.", map: "Eataly Flatiron" },
  { name: "Macy's Herald Square", detail: "Indoor shopping, historic, 5 blocks from hotel. Wooden escalators are the move.", map: "Macy's Herald Square" },
];

const meltdownCuts = [
  { day: "Wednesday", cut: "Skip Ellis Island second leg (just Liberty), shorten 9/11 to outdoor only, taxi back instead of subway" },
  { day: "Thursday", cut: "Skip lingering at Rockefeller plaza, Uber back after Wicked instead of subway" },
  { day: "Friday", cut: "Don't try to 'see all' of Central Park (lower loop only), if tired skip SoHo entirely" },
  { day: "Saturday", cut: "Skip DUMBO lunch (just photos), walk only halfway across Brooklyn Bridge" },
  { day: "Sunday", cut: "Don't linger after game, subway straight back, dinner = takeout if needed" },
