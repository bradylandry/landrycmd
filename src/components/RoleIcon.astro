---
// Role glyph used as the node marker on experience rails.
// Device types (arista / mx2020 / asr9k) render with blinking status LEDs.
// type: arista | mx2020 | asr9k | switch | rf | datacenter | desktop | agent
const { type } = Astro.props;
---

<span class="role-icon" aria-hidden="true">
  {type === "arista" && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="18" width="42" height="13" rx="2" />
      <g stroke-width="1.1">
        <rect x="16" y="21" width="3" height="3" rx="0.5" />
        <rect x="20" y="21" width="3" height="3" rx="0.5" />
        <rect x="24" y="21" width="3" height="3" rx="0.5" />
        <rect x="28" y="21" width="3" height="3" rx="0.5" />
        <rect x="32" y="21" width="3" height="3" rx="0.5" />
        <rect x="36" y="21" width="3" height="3" rx="0.5" />
        <rect x="16" y="25.5" width="3" height="3" rx="0.5" />
        <rect x="20" y="25.5" width="3" height="3" rx="0.5" />
        <rect x="24" y="25.5" width="3" height="3" rx="0.5" />
        <rect x="28" y="25.5" width="3" height="3" rx="0.5" />
        <rect x="32" y="25.5" width="3" height="3" rx="0.5" />
        <rect x="36" y="25.5" width="3" height="3" rx="0.5" />
      </g>
      <g class="leds">
        <rect class="led" x="7.5" y="21" width="3" height="3" rx="0.6" />
        <rect class="led led-a" x="7.5" y="25.5" width="3" height="3" rx="0.6" />
      </g>
    </svg>
  )}
  {type === "mx2020" && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="14" y="4" width="20" height="40" rx="2" />
      <g stroke-width="1.1">
        <line x1="14" y1="9.7" x2="34" y2="9.7" />
        <line x1="14" y1="15.4" x2="34" y2="15.4" />
        <line x1="14" y1="21.1" x2="34" y2="21.1" />
        <line x1="14" y1="26.8" x2="34" y2="26.8" />
        <line x1="14" y1="32.5" x2="34" y2="32.5" />
        <line x1="14" y1="38.2" x2="34" y2="38.2" />
        <line x1="18" y1="4" x2="18" y2="44" />
      </g>
      <g class="leds">
        <rect class="led" x="29.5" y="6" width="2.4" height="2.4" rx="0.5" />
        <rect class="led led-a" x="29.5" y="11.7" width="2.4" height="2.4" rx="0.5" />
        <rect class="led" x="29.5" y="17.4" width="2.4" height="2.4" rx="0.5" />
        <rect class="led led-a" x="29.5" y="23.1" width="2.4" height="2.4" rx="0.5" />
        <rect class="led" x="29.5" y="28.8" width="2.4" height="2.4" rx="0.5" />
        <rect class="led led-a" x="29.5" y="34.5" width="2.4" height="2.4" rx="0.5" />
      </g>
    </svg>
  )}
  {type === "asr9k" && (
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="10" width="38" height="28" rx="2" />
      <g stroke-width="1.1">
        <line x1="5" y1="17" x2="43" y2="17" />
        <line x1="5" y1="24" x2="43" y2="24" />
        <line x1="5" y1="31" x2="43" y2="31" />
        <line x1="14" y1="10" x2="14" y2="38" />
      </g>
      <g class="leds">
        <rect class="led" x="8" y="12.5" width="2.6" height="2.6" rx="0.5" />
        <rect class="led led-a" x="8" y="19.5" width="2.6" height="2.6" rx="0.5" />
        <rect class="led" x="8" y="26.5" width="2.6" height="2.6" rx="0.5" />
        <rect class="led led-a" x="8" y="33.5" width="2.6" height="2.6" rx="0.5" />
      </g>
    </svg>
  )}
  {type === "switch" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="9" width="18" height="8" rx="1.5" />
      <line x1="7" y1="13" x2="7.01" y2="13" />
      <line x1="11" y1="13" x2="11.01" y2="13" />
      <line x1="15" y1="13" x2="15.01" y2="13" />
      <path d="M6 9 V6 h4" />
      <path d="M18 17 v3 h-4" />
    </svg>
  )}
  {type === "rf" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="1.6" />
      <path d="M8.8 8.8 a4.5 4.5 0 0 0 0 6.4" />
      <path d="M15.2 8.8 a4.5 4.5 0 0 1 0 6.4" />
      <path d="M6.3 6.3 a8 8 0 0 0 0 11.4" />
      <path d="M17.7 6.3 a8 8 0 0 1 0 11.4" />
    </svg>
  )}
  {type === "datacenter" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="6" rx="1.5" />
      <rect x="3" y="14" width="18" height="6" rx="1.5" />
      <line x1="7" y1="7" x2="7.01" y2="7" />
      <line x1="7" y1="17" x2="7.01" y2="17" />
    </svg>
  )}
  {type === "agent" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="12" x2="5" y2="6" />
      <line x1="12" y1="12" x2="19" y2="8" />
      <line x1="12" y1="12" x2="7" y2="19" />
      <line x1="12" y1="12" x2="18" y2="18" />
      <circle cx="5" cy="6" r="1.5" />
      <circle cx="19" cy="8" r="1.5" />
      <circle cx="7" cy="19" r="1.5" />
      <circle cx="18" cy="18" r="1.5" />
      <circle class="core" cx="12" cy="12" r="3.2" />
    </svg>
  )}
  {type === "desktop" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="12" rx="1.5" />
      <line x1="9" y1="20" x2="15" y2="20" />
      <line x1="12" y1="16" x2="12" y2="20" />
    </svg>
  )}
</span>
