const diagram = diagrams[lab];
---

<svg
  class="lab-thumb"
  viewBox="0 0 480 156"
  data-lab-thumb={lab}
  aria-hidden="true"
  focusable="false"
>
  {
    diagram.sea && <rect class="sea" x="0" y="0" width="480" height="156" />
  }
  {
    diagram.rings?.map((ring) => (
      <circle
        class:list={["ring", ring.tone]}
        cx={ring.cx}
        cy={ring.cy}
        r={ring.r}
      />
    ))
  }
  {diagram.land && <path class="land" d={diagram.land} />}
  {diagram.cloud && <path class="cloud" d={diagram.cloud} />}
  {
    diagram.edges.map((d) => (
      <path class="edge" fill="none" d={d} />
    ))
  }
  {
    diagram.edges.map((d) => (
      <path class="flow on" fill="none" d={d} />
    ))
  }
  {
    diagram.nodes.map((node) => (
      <g class:list={["node", node.hub && "hub"]}>
        <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="2" ry="2" />
        <text x={node.x + node.w / 2} y={node.y + node.h / 2 + 4}>
          {node.label}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .lab-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 480 / 156;
    background: var(--bg);
    border: 0;
    border-radius: 0;
  }
  .lab-thumb .sea {
    fill: #0b1a26;
  }
  .lab-thumb .land {
    fill: #121a16;
    stroke: #3a4553;
    stroke-width: 1;
  }
  .lab-thumb .cloud {
    fill: rgba(16, 20, 26, 0.45);
    stroke: #3a4553;
    stroke-width: 1;
  }
  .lab-thumb .ring {
    fill: rgba(255, 106, 0, 0.12);
    stroke: #ff6a00;
    stroke-width: 1;
  }
  .lab-thumb .ring.b {
    fill: rgba(255, 210, 173, 0.16);
    stroke: #ffd2ad;
  }
  .lab-thumb .edge {
    fill: none;
    stroke: #2c3542;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 1;
  }
  .lab-thumb .node rect {
    fill: #10141a;
    stroke: #3a4553;
    stroke-width: 1;
  }
  .lab-thumb .hub rect {
    stroke: #a9b1bc;
    fill: #10141a;
  }
  .lab-thumb text {
    fill: #a9b1bc;
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    pointer-events: none;
  }
  .lab-thumb .hub text {
    fill: #eceef1;
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-thumb {
      transition: none;
    }
  }
</style>
