const diagram = diagrams[lab];
---

<svg
  class="lab-thumb"
  viewBox="0 0 480 156"
  data-lab-thumb={lab}
  aria-hidden="true"
  focusable="false"
>
  {
    diagram.sea && <rect class="sea" x="0" y="0" width="480" height="156" />
  }
  {
    diagram.rings?.map((ring) => (
      <circle
        class:list={["ring", ring.tone]}
        cx={ring.cx}
        cy={ring.cy}
        r={ring.r}
      />
    ))
  }
  {diagram.land && <path class="land" d={diagram.land} />}
  {
    diagram.edges.map((d) => (
      <path class="edge" fill="none" d={d} />
    ))
  }
  {
    diagram.edges.map((d) => (
      <path class="flow on" fill="none" d={d} />
    ))
  }
  {
    diagram.nodes.map((node) => (
      <g class:list={["node", node.hub && "hub"]}>
        <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
        <text x={node.x + node.w / 2} y={node.y + node.h / 2 + 4}>
          {node.label}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .lab-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 480 / 156;
    background: var(--bg);
    border: 0;
    border-radius: 0;
  }
  .lab-thumb .sea {
    fill: #0c4a6e;
  }
  .lab-thumb .land {
    fill: #1c3a2c;
    stroke: #e7d3a1;
    stroke-width: 1.4;
  }
  .lab-thumb .ring {
    fill: rgba(245, 158, 11, 0.28);
    stroke: #fbbf24;
    stroke-width: 1.25;
  }
  .lab-thumb .ring.b {
    fill: rgba(34, 211, 238, 0.28);
    stroke: #67e8f9;
  }
  .lab-thumb .edge {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
  }
  .lab-thumb .node rect {
    fill: var(--bg);
    stroke: var(--accent-voice);
    stroke-width: 1.75;
  }
  .lab-thumb .hub rect {
    stroke: var(--accent);
  }
  .lab-thumb text {
    fill: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-thumb {
      transition: none;
    }
  }
</style>
