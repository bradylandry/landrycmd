---
import type { LabSlug } from "../lib/labs";

interface Props {
  lab: LabSlug;
}

const { lab } = Astro.props;

interface Node {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  hub?: boolean;
}

interface Ring {
  cx: number;
  cy: number;
  r: number;
  tone?: "a" | "b";
}

interface Diagram {
  edges: string[];
  nodes: Node[];
  sea?: boolean;
  land?: string;
  rings?: Ring[];
  cloud?: string;
}

