---
import {
  EARLY_CAREER,
  getResume,
  type DisclosedRoleCopy,
  type ResumeVariant,
} from "../lib/resume";

interface Props {
  preparedFor?: string;
  /**
   * Name the firm. ONLY ever true on unlisted, noindex /resume/<token> routes
   * sent directly to an employer. The public /resume must never set this.
   */
  disclosed?: boolean;
  variant?: ResumeVariant;
  /** Already loaded by the token route so this render does not read it again. */
  disclosedRole?: DisclosedRoleCopy | null;
}
const { preparedFor, disclosed = false, variant = "network", disclosedRole } = Astro.props;
const { headline, summary, skills, experience } = getResume({
  disclosed,
  variant,
  ...(disclosed ? { disclosedRole: disclosedRole ?? null } : {}),
});
---

  <section class="hero">
    <h1>Brady Landry</h1>
    <p class="role">{headline}</p>
    {preparedFor && <p class="prepared-for">Prepared for {preparedFor}</p>}
    <p class="contact-line">Lafayette, LA · (504) 444-9010 · bjlandry@gmail.com</p>
    <p class="text-links">
      <a href="https://www.linkedin.com/in/bradylandry/" rel="noopener">LinkedIn</a>
      <a href="https://github.com/bradylandry" rel="noopener">GitHub</a>
      <a href="mailto:bjlandry@gmail.com">Email</a>
    </p>
  </section>

  <section id="summary">
    <p class="kicker">// summary</p>
    <h2>Summary</h2>
    <p>{summary}</p>
  </section>

  <section id="skills">
    <p class="kicker">// skills</p>
    <h2>Skills</h2>
    {
      skills.map((s) => (
        <p class="skill-row">
          <strong>{s.label}:</strong> {s.items}
        </p>
      ))
    }
  </section>

  <section id="experience">
    <p class="kicker">// experience</p>
    <h2>Experience</h2>
    <div class="rows">
    {
      experience.map((e) => (
        <div class="role">
          <div class="project-head">
            <h3>{e.role}</h3>
            <span class="muted">{e.org}</span>
            <span class="years">{e.period}</span>
          </div>
          <ul>
            {e.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
    </div>
  </section>

  <section id="early-career">
    <details>
      <summary>Early career (2003 – 2011)</summary>
      <div class="rows">
      {
        EARLY_CAREER.map((e) => (
          <div class="role">
            <div class="project-head">
              <h3>{e.role}</h3>
              <span class="muted">{e.org}</span>
              <span class="links">{e.period}</span>
            </div>
            {e.bullets.length > 0 && (
              <ul>
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      </div>
    </details>
  </section>

  <section id="education">
    <p class="kicker">// education</p>
    <h2>Education & Training</h2>
    <p class="skill-row">
      <strong>Louisiana Technical College</strong>, Network Administration (2000 – 2002)
    </p>
    <p class="skill-row">
      <strong>Certifications:</strong> CCNA, CCNP (expired 2022)
    </p>
  </section>

<style>
  .skill-row {
    margin: 0.4rem 0;
    line-height: 1.5;
  }
  .project-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .project-head h3 {
    font-size: var(--fs-base);
  }
  .rows .role {
    margin: 0;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-700);
  }
  .role ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
  .role li {
    margin: 0.3rem 0;
    line-height: 1.5;
  }
  details {
    margin-top: 0.5rem;
  }
  details summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.4rem 0;
  }
  details[open] summary {
    margin-bottom: 0.5rem;
  }
  .contact-line {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
  }
  .prepared-for {
    margin: 0.4rem 0 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--accent);
    opacity: 0.85;
  }
</style>
