# Copy to .env and fill in, or run `vercel env pull .env` after `vercel link`.
# Every one of these lives in the Vercel project settings; none are in git.
#
# The site builds and serves without any of them. What breaks without each is
# noted below, so you can set only what you need locally.

# --- Upstash Redis -----------------------------------------------------------
# Backs trip voting and the tracked-résumé hit counters.
# The Vercel/Upstash integration injects either UPSTASH_* or KV_* depending on
# which marketplace flow was used; prefer UPSTASH_* (see src/lib/redis.ts).
# Without these: pages still render, tracking silently records nothing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names, only if the project predates the Upstash integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Auth for private routes -------------------------------------------------
# Gates /trips/* and /applications via src/middleware.ts.
# TRIP_SECRET signs the auth cookie; TRIP_PIN is what you type at /trips/login.
# Without these: those routes return HTTP 500 (fail closed, by design).
TRIP_SECRET=
TRIP_PIN=

# --- Obsidian publish API ----------------------------------------------------
# Used by src/pages/api/publish-note.ts to commit notes into this repo.
# Without these: the publish endpoint is non-functional; the rest of the site
# is unaffected.
GITHUB_TOKEN=
GITHUB_REPO=
PUBLISH_API_KEY=
