# Copy to .env and fill in, or run `vercel env pull .env` after `vercel link`.
# Every one of these lives in the Vercel project settings; none are in git.
#
# The public site builds and serves without any of them. What breaks without
# each is noted below, so you can set only what you need locally.

# --- Upstash Redis -----------------------------------------------------------
# Backs tracked-résumé hit counters and the /applications login rate limit.
# The Vercel/Upstash integration injects either UPSTASH_* or KV_* depending on
# which marketplace flow was used; prefer UPSTASH_* (see src/lib/redis.ts).
# Without these: pages still render, tracking silently records nothing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV names, only if the project predates the Upstash integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Auth for /applications --------------------------------------------------
# APPS_SECRET signs the applications auth cookie. If it is unset, TRIP_SECRET
# is still accepted. APPS_PIN is the code entered at /login. Without a signing
# secret and APPS_PIN: /applications returns HTTP 500 (fail closed).
APPS_SECRET=
APPS_PIN=
# TRIP_SECRET=

# --- Private application and résumé data ------------------------------------
# Read at runtime by /applications and /resume/<token>. Do not commit values.
# Put the JSON in private/applications.json and private/disclosed-role.json
# (both gitignored), then run: node scripts/load-private.mjs
# That writes this local .env only. Copy those values into Vercel by hand.
# Raw JSON also works. The script's form is safe for dotenv.
# Without APPLICATIONS_JSON, /applications and /resume/<token> fail closed.
# Without DISCLOSED_ROLE_JSON, disclosed résumé links fail closed.
APPLICATIONS_JSON=
DISCLOSED_ROLE_JSON=

# --- Obsidian publish API ----------------------------------------------------
# Used by src/pages/api/publish-note.ts to commit notes into this repo.
# Without these: the publish endpoint is non-functional; the rest of the site
# is unaffected.
GITHUB_TOKEN=
GITHUB_REPO=
PUBLISH_API_KEY=
